{
  "manifest_version": 3,
  "name": "图提取 · 电商图片下载",
  "version": "1.0.0",
  "description": "一键提取淘宝、京东、拼多多商家版商品详情页的全部图片，新页面集中勾选并批量下载为 PNG。",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],

  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "图提取 · 提取当前页面图片",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["js/hosts.js", "js/collect.js", "js/content.js"],
      "css": ["css/content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "js/hosts.js", "js/collect.js"],
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
